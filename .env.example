# Local development values only. Copy to .env at the repository root.
POSTGRES_USER=bnc
POSTGRES_PASSWORD=bnc_local
POSTGRES_DB=bnc
DATABASE_URL=postgresql+psycopg://bnc:bnc_local@localhost:5432/bnc
REDIS_URL=redis://localhost:6379/0
API_INTERNAL_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
APP_TIMEZONE=Asia/Dhaka
# Deprecated legacy service token; it no longer authenticates dashboard users.
# Retained for older environments only; leave blank.
INGESTION_API_TOKEN=
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=bnc-media
S3_ACCESS_KEY=bnc_local
S3_SECRET_KEY=bnc_local_storage_password
# API and worker only. Choose a Responses + Structured Outputs capable model.
# Leave blank to disable AI; generation returns a useful configuration error.
# Never add these to NEXT_PUBLIC_* variables or commit your real .env.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_HOURLY_LIMIT=20
# Future publishing integrations: leave inactive.
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
META_APP_ID=
META_APP_SECRET=

# Individual accounts: local HTTP only. Production must use HTTPS and true.
AUTH_COOKIE_SECURE=false
AUTH_ORIGIN=http://localhost:3000
# Exact additional HTTPS origins, JSON array. Shared by API and dashboard proxy.
# AUTH_ORIGIN remains localhost; public HTTPS cookies are always Secure.
AUTH_ADDITIONAL_ORIGINS=["https://trustable-detail-drift.ngrok-free.dev"]
# Generate a Fernet key on the API host; required for Superadmin MFA enrollment.
AUTH_ENCRYPTION_KEY=
AUTH_SESSION_HOURS=8
AUTH_REQUIRE_EDITOR_MFA=false
# SMTP must support STARTTLS. Password reset tokens never appear in API responses.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

